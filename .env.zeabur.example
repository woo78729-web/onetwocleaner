# Laravel API 服務（Zeabur Root Directory: / 留空或 .）
# 萬兔站專用 — 請綁定萬兔自己的 MySQL / LINE Channel，勿沿用東東
APP_NAME=萬兔冷氣專業清洗
APP_ENV=production
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=Asia/Taipei

# 於 Zeabur 控制台綁定「萬兔」MySQL 後注入，勿寫入 Git、勿複製東東 DATABASE_URL
DATABASE_URL=

ZBPACK_PHP_OPTIMIZE=true
# 必須設定為萬兔前端實際網域
CORS_ALLOWED_ORIGINS=
SANCTUM_EXPIRATION=480
LOG_LEVEL=warning

# 建議使用 database，避免空 storage volume 造成 cache path 500／白屏
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# 於 Zeabur 控制台產生後設定
APP_KEY=

# LINE Messaging API（Webhook：{APP_URL}/api/line/webhook）
# 填寫萬兔專屬 Channel Access Token / Channel Secret
LINE_BOT_CHANNEL_ACCESS_TOKEN=
LINE_BOT_CHANNEL_SECRET=

# 外部 Cron（每日 18:00 打 /api/cron/send-tomorrow-schedules?token=...）
# 請使用與東東不同的 CRON_SECRET
CRON_SECRET=

# 部署時會自動執行（composer install / 容器啟動）：
#   php artisan migrate --force
#   php artisan storage:link --force
# 若大頭貼仍 403，請確認 public/storage 為 symlink 而非一般資料夾。
# 建立管理員：
# php artisan admin:ensure 邱泰翔 z34178900 --name=阿泰
